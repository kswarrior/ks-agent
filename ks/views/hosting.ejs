<section class="stats-grid hosting-stats">
  <div class="card stat-card hosting-card">
    <div class="stat-top">
      <span class="stat-label">Active Domains</span>
      <div class="stat-icon purple"><i class="fa-solid fa-globe"></i></div>
    </div>
    <div class="stat-value">247</div>
    <div class="stat-change up"><i class="fa-solid fa-arrow-up"></i> 4.1% vs last week</div>
  </div>

  <div class="card stat-card hosting-card">
    <div class="stat-top">
      <span class="stat-label">Servers Online</span>
      <div class="stat-icon blue"><i class="fa-solid fa-server"></i></div>
    </div>
    <div class="stat-value">18 / 19</div>
    <div class="stat-change down"><i class="fa-solid fa-circle-exclamation"></i> 1 under maintenance</div>
  </div>

  <div class="card stat-card hosting-card">
    <div class="stat-top">
      <span class="stat-label">Avg. Uptime</span>
      <div class="stat-icon green"><i class="fa-solid fa-clock"></i></div>
    </div>
    <div class="stat-value">99.97%</div>
    <div class="stat-change up"><i class="fa-solid fa-arrow-up"></i> 0.02% this month</div>
  </div>

  <div class="card stat-card hosting-card">
    <div class="stat-top">
      <span class="stat-label">Bandwidth Used</span>
      <div class="stat-icon orange"><i class="fa-solid fa-network-wired"></i></div>
    </div>
    <div class="stat-value">4.8 TB</div>
    <div class="stat-change up"><i class="fa-solid fa-arrow-up"></i> 18% vs last month</div>
  </div>
</section>

<section class="content-grid hosting-grid">
  <div class="panel hosting-panel">
    <div class="panel-header">
      <h2 class="panel-title">Server Performance</h2>
      <span class="panel-action">View logs →</span>
    </div>
    <div class="hosting-server-list">
      <div class="server-row">
        <div class="server-info">
          <span class="server-dot online"></span>
          <div>
            <div class="server-name">web-server-01</div>
            <div class="server-ip">192.168.1.10</div>
          </div>
        </div>
        <div class="server-cpu-cpu">
          <div class="mini-bar-wrap"><div class="mini-bar" style="width:34%"></div></div>
          <span class="mini-label">34%</span>
        </div>
        <div class="server-ram">
          <div class="mini-bar-wrap"><div class="mini-bar ram" style="width:62%"></div></div>
          <span class="mini-label">62%</span>
        </div>
        <div class="server-status-label online">Running</div>
      </div>

      <div class="server-row">
        <div class="server-info">
          <span class="server-dot online"></span>
          <div>
            <div class="server-name">web-server-02</div>
            <div class="server-ip">192.168.1.11</div>
          </div>
        </div>
        <div class="server-cpu-cpu">
          <div class="mini-bar-wrap"><div class="mini-bar" style="width:78%"></div></div>
          <span class="mini-label">78%</span>
        </div>
        <div class="server-ram">
          <div class="mini-bar-wrap"><div class="mini-bar ram" style="width:85%"></div></div>
          <span class="mini-label">85%</span>
        </div>
        <div class="server-status-label online">Running</div>
      </div>

      <div class="server-row">
        <div class="server-info">
          <span class="server-dot warning"></span>
          <div>
            <div class="server-name">db-master</div>
            <div class="server-ip">192.168.1.20</div>
          </div>
        </div>
        <div class="server-cpu-cpu">
          <div class="mini-bar-wrap"><div class="mini-bar" style="width:91%"></div></div>
          <span class="mini-label">91%</span>
        </div>
        <div class="server-ram">
          <div class="mini-bar-wrap"><div class="mini-bar ram" style="width:94%"></div></div>
          <span class="mini-label">94%</span>
        </div>
        <div class="server-status-label warning">High Load</div>
      </div>

      <div class="server-row">
        <div class="server-info">
          <span class="server-dot offline"></span>
          <div>
            <div class="server-name">backup-node-03</div>
            <div class="server-ip">192.168.1.33</div>
          </div>
        </div>
        <div class="server-cpu-cpu">
          <div class="mini-bar-wrap"><div class="mini-bar gray" style="width:0%"></div></div>
          <span class="mini-label">—</span>
        </div>
        <div class="server-ram">
          <div class="mini-bar-wrap"><div class="mini-bar ram gray" style="width:0%"></div></div>
          <span class="mini-label">—</span>
        </div>
        <div class="server-status-label offline">Offline</div>
      </div>

      <div class="server-row">
        <div class="server-info">
          <span class="server-dot online"></span>
          <div>
            <div class="server-name">cdn-edge-01</div>
            <div class="server-ip">10.0.0.55</div>
          </div>
        </div>
        <div class="server-cpu-cpu">
          <div class="mini-bar-wrap"><div class="mini-bar" style="width:22%"></div></div>
          <span class="mini-label">22%</span>
        </div>
        <div class="server-ram">
          <div class="mini-bar-wrap"><div class="mini-bar ram" style="width:47%"></div></div>
          <span class="mini-label">47%</span>
        </div>
        <div class="server-status-label online">Running</div>
      </div>
    </div>
  </div>

  <div class="panel hosting-panel">
    <div class="panel-header">
      <h2 class="panel-title">Email Hosting</h2>
      <span class="panel-action">Manage →</span>
    </div>
    <div class="hosting-email-brief">
      <div class="email-item">
        <div class="email-icon"><i class="fa-solid fa-envelope"></i></div>
        <div class="email-info">
          <div class="email-name">info@ksapp.com</div>
          <div class="email-detail">30 GB used · 2.4k emails today</div>
        </div>
        <span class="pill success"><span class="pill-dot"></span> Active</span>
      </div>
      <div class="email-item">
        <div class="email-icon"><i class="fa-solid fa-envelope"></i></div>
        <div class="email-info">
          <div class="email-name">support@ksapp.com</div>
          <div class="email-detail">45 GB used · 1.1k emails today</div>
        </div>
        <span class="pill success"><span class="pill-dot"></span> Active</span>
      </div>
      <div class="email-item">
        <div class="email-icon"><i class="fa-solid fa-envelope"></i></div>
        <div class="email-info">
          <div class="email-name">billing@ksapp.com</div>
          <div class="email-detail">10 GB used · 184 emails today</div>
        </div>
        <span class="pill warning"><span class="pill-dot"></span> Quota 80%</span>
      </div>
    </div>

    <div class="panel" style="margin-top:18px; background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:18px;">
      <div class="panel-title" style="margin-bottom:10px;">DNS Records</div>
      <div class="dns-row"><span class="dns-type A">A</span><span>@</span><span>192.168.1.10</span><span>120</span><span>Auto-renewed</span></div>
      <div class="dns-row"><span class="dns-type CNAME">CNAME</span><span>www</span><span>@</span><span>300</span><span>Auto-renewed</span></div>
      <div class="dns-row"><span class="dns-type MX">MX</span><span>@</span><span>mail.ksapp.com</span><span>60</span><span>Auto-renewed</span></div>
      <div class="dns-row"><span class="dns-type TXT">TXT</span><span>@</span><span>v=spf1 ...</span><span>3600</span><span>Auto-renewed</span></div>
    </div>
  </div>
</section>

<section class="panel hosting-activity-panel">
  <div class="panel-header">
    <h2 class="panel-title">Hosting Activity Log</h2>
    <span class="panel-action">View all →</span>
  </div>
  <div class="hosting-activity-list">
    <div class="hosting-activity-item">
      <div class="activity-dot" style="background:var(--success)"></div>
      <div class="activity-content">
        <div class="activity-title">Auto-backup completed — db-master</div>
        <div class="activity-time">14 min ago</div>
      </div>
    </div>
    <div class="hosting-activity-item">
      <div class="activity-dot" style="background:var(--warning)"></div>
      <div class="activity-content">
        <div class="activity-title">SSL certificate expiring in 7 days — portal.ksapp.com</div>
        <div class="activity-time">1 hour ago</div>
      </div>
    </div>
    <div class="hosting-activity-item">
      <div class="activity-dot" style="background:var(--danger)"></div>
      <div class="activity-content">
        <div class="activity-title">backup-node-03 went offline (power loss)</div>
        <div class="activity-time">3 hours ago</div>
      </div>
    </div>
    <div class="hosting-activity-item">
      <div class="activity-dot" style="background:var(--primary)"></div>
      <div class="activity-content">
        <div class="activity-title">New domain registered: startup.ksapp.com</div>
        <div class="activity-time">6 hours ago</div>
      </div>
    </div>
    <div class="hosting-activity-item">
      <div class="activity-dot" style="background:var(--success)"></div>
      <div class="activity-content">
        <div class="activity-title">Disk usage alert resolved — cdn-edge-01</div>
        <div class="activity-time">Yesterday</div>
      </div>
    </div>
  </div>
</section>