<%- include('partials/header') %>

<div class="main-content">
  <div class="page-intro">
    <h1>Stats & Achievements 🏆</h1>
    <p class="subtitle">Numbers that prove the legend is real</p>
  </div>

  <!-- Skill Mastery -->
  <div class="grid-2">
    <div class="card">
      <div class="card-header">
        <h2>⚔️ Combat Mastery</h2>
      </div>
      <div class="skill-list">
        <div class="skill">
          <div class="skill-header"><span>Swordsmanship</span><span class="level">Level 97</span></div>
          <div class="progress-bar"><div class="fill" style="width: 97%;"></div></div>
        </div>
        <div class="skill">
          <div class="skill-header"><span>Archery</span><span class="level">Level 84</span></div>
          <div class="progress-bar"><div class="fill" style="width: 84%;"></div></div>
        </div>
        <div class="skill">
          <div class="skill-header"><span>Axes</span><span class="level">Level 72</span></div>
          <div class="progress-bar"><div class="fill" style="width: 72%;"></div></div>
        </div>
        <div class="skill">
          <div class="skill-header"><span>Shields</span><span class="level">Level 68</span></div>
          <div class="progress-bar"><div class="fill" style="width: 68%;"></div></div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h2>⛏️ Gathering Skills</h2>
      </div>
      <div class="skill-list">
        <div class="skill">
          <div class="skill-header"><span>Mining</span><span class="level">Level 99</span></div>
          <div class="progress-bar"><div class="fill" style="width: 99%;"></div></div>
        </div>
        <div class="skill">
          <div class="skill-header"><span>Woodcutting</span><span class="level">Level 87</span></div>
          <div class="progress-bar"><div class="fill" style="width: 87%;"></div></div>
        </div>
        <div class="skill">
          <div class="skill-header"><span>Farming</span><span class="level">Level 65</span></div>
          <div class="progress-bar"><div class="fill" style="width: 65%;"></div></div>
        </div>
        <div class="skill">
          <div class="skill-header"><span>Fishing</span><span class="level">Level 54</span></div>
          <div class="progress-bar"><div class="fill" style="width: 54%;"></div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Major Achievements -->
  <div class="card" style="margin-top: 24px;">
    <div class="card-header">
      <h2>🏅 Major Achievements</h2>
    </div>
    <div class="grid-3">
      <div class="achievement">
        <div class="achievement-icon"><i class="fas fa-crown"></i></div>
        <div>
          <h3>Diamond Lord</h3>
          <p>Mine 10,000 diamonds</p>
          <span class="rarity legendary">Legendary</span>
        </div>
      </div>
      <div class="achievement">
        <div class="achievement-icon"><i class="fas fa-dragon"></i></div>
        <div>
          <h3>Ender Slayer</h3>
          <p>Defeat Ender Dragon 50x</p>
          <span class="rarity epic">Epic</span>
        </div>
      </div>
      <div class="achievement">
        <div class="achievement-icon"><i class="fas fa-fire"></i></div>
        <div>
          <h3>Nether Survivor</h3>
          <p>24h in the Nether</p>
          <span class="rarity rare">Rare</span>
        </div>
      </div>
      <div class="achievement">
        <div class="achievement-icon"><i class="fas fa-skull"></i></div>
        <div>
          <h3>Wither Hunter</h3>
          <p>Kill 100 Withers</p>
          <span class="rarity legendary">Legendary</span>
        </div>
      </div>
      <div class="achievement">
        <div class="achievement-icon"><i class="fas fa-water"></i></div>
        <div>
          <h3>Heart of the Sea</h3>
          <p>Find all buried treasures</p>
          <span class="rarity epic">Epic</span>
        </div>
      </div>
      <div class="achievement">
        <div class="achievement-icon"><i class="fas fa-mountain"></i></div>
        <div>
          <h3>Peak Climber</h3>
          <p>Reach build limit Y=320</p>
          <span class="rarity rare">Rare</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Server Presence -->
  <div class="card" style="margin-top: 24px;">
    <div class="card-header">
      <h2>🖥️ Server Presence</h2>
    </div>
    <div class="server-item">
      <div class="server-info">
        <div class="server-icon"><i class="fas fa-cubes"></i></div>
        <div class="server-details">
          <h4>Hypixel</h4>
          <span class="status"><span class="status-dot"></span>Online</span>
        </div>
      </div>
      <span style="color: var(--text-muted);">MVP++ • Guild Master</span>
    </div>
    <div class="server-item">
      <div class="server-info">
        <div class="server-icon"><i class="fas fa-shield-alt"></i></div>
        <div class="server-details">
          <h4>MineHeroes</h4>
          <span class="status"><span class="status-dot"></span>Online</span>
        </div>
      </div>
      <span style="color: var(--text-muted);">Diamond • Faction Leader</span>
    </div>
    <div class="server-item">
      <div class="server-info">
        <div class="server-icon"><i class="fas fa-city"></i></div>
        <div class="server-details">
          <h4>Purple Prison</h4>
          <span class="status"><span class="status-dot"></span>Online</span>
        </div>
      </div>
      <span style="color: var(--text-muted);">A5 • #1 Prestige</span>
    </div>
  </div>

  <div style="margin-top: 20px; text-align: center; color: var(--text-muted); font-size: 0.85rem;">
    &copy; 2025 <strong>KS Warrior</strong>. All rights reserved.
  </div>
</div>

<script src="/javascripts/main.js"></script>
</body>
</html>