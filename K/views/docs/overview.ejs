<%- include('../partials/header') %>

<%
  const docsPages = [
    { href: '/docs',         label: 'Overview',     icon: 'fas fa-book-open',    active: 'docs' },
    { href: '/docs/api',     label: 'API Reference', icon: 'fas fa-plug',        active: 'docs-api' },
    { href: '/docs/plugins', label: 'Plugins',       icon: 'fas fa-puzzle-piece', active: 'docs-plugins' },
    { href: '/docs/server',  label: 'Server Setup',  icon: 'fas fa-server',       active: 'docs-server' },
  ];
  function isActive(label) { return active === (docsPages.find(p => p.label === label)?.active || '') ? ' active' : ''; }
%>

<div class="main-content">
  <!-- Breadcrumb -->
  <nav class="breadcrumbs">
    <span class="current">Documentation</span>
  </nav>

  <div class="doc-layout">

    <!-- In-page sidebar -->
    <aside class="doc-sidebar-nav">
      <h4>Pages</h4>
      <nav class="doc-nav-list">
        <% docsPages.forEach(p => { %>
          <a href="<%= p.href %>" class="<%= isActive(p.label) %>">
            <i class="<%= p.icon %>"></i>
            <%= p.label %>
          </a>
        <% }) %>
      </nav>
    </aside>

    <!-- Content -->
    <article class="doc-content">
      <h1><i class="fas fa-book-open" style="color: var(--accent-light);"></i> Documentation Overview</h1>
      <p class="doc-desc">
        The KS Warrior documentation covers everything you need to integrate, extend, and manage the platform. Choose a section below to get started.
      </p>

      <div class="info-callout">
        <strong>💡 New here?</strong> If you're setting up the server for the first time, start with <a href="/docs/server" style="color:var(--accent-light)">Server Setup</a>, then follow <a href="/docs/api" style="color:var(--accent-light)">API Reference</a> to make your first call.
      </div>

      <h2><i class="fas fa-layer-group"></i> Getting Started</h2>
      <p>Follow these three steps to have KS Warrior running locally or on your own VPS:</p>
      <ol>
        <li>Clone the repository and install the dependencies.</li>
        <li>Configure <code>config.json</code> with your server hostname and port.</li>
        <li>Run <code>npm start</code> and open <code>http://localhost:3000</code>.</li>
      </ol>

      <h2><i class="fas fa-th-large"></i> Sections at a Glance</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 10px;">

        <a href="/docs/api" class="card" style="text-decoration:none; display:block;">
          <div class="card-header">
            <div>
              <div style="color: var(--text-muted); font-size: 0.8rem; margin-bottom: 4px;">Integration</div>
              <div style="font-weight: 700;">API Reference</div>
            </div>
            <div class="icon-badge purple"><i class="fas fa-plug"></i></div>
          </div>
          <p style="color: var(--text-muted); font-size: 0.9rem;">REST endpoints, auth, request bodies and response codes.</p>
        </a>

        <a href="/docs/plugins" class="card" style="text-decoration:none; display:block;">
          <div class="card-header">
            <div>
              <div style="color: var(--text-muted); font-size: 0.8rem; margin-bottom: 4px;">Extensibility</div>
              <div style="font-weight: 700;">Plugins</div>
            </div>
            <div class="icon-badge yellow"><i class="fas fa-puzzle-piece"></i></div>
          </div>
          <p style="color: var(--text-muted); font-size: 0.9rem;">Official and community plugins, install and configuration.</p>
        </a>

        <a href="/docs/server" class="card" style="text-decoration:none; display:block;">
          <div class="card-header">
            <div>
              <div style="color: var(--text-muted); font-size: 0.8rem; margin-bottom: 4px;">Operations</div>
              <div style="font-weight: 700;">Server Setup</div>
            </div>
            <div class="icon-badge blue"><i class="fas fa-server"></i></div>
          </div>
          <p style="color: var(--text-muted); font-size: 0.9rem;">System requirements, ports, database, and runtime flags.</p>
        </a>
      </div>

      <h2><i class="fas fa-tags"></i> Key Topics</h2>
      <div>
        <span class="doc-pill"><i class="fas fa-check-circle"></i> Authentication</span>
        <span class="doc-pill"><i class="fas fa-check-circle"></i> Players</span>
        <span class="doc-pill"><i class="fas fa-check-circle"></i> Servers</span>
        <span class="doc-pill"><i class="fas fa-check-circle"></i> Plugins</span>
        <span class="doc-pill"><i class="fas fa-check-circle"></i> Clans</span>
        <span class="doc-pill"><i class="fas fa-check-circle"></i> Leaderboard</span>
        <span class="doc-pill"><i class="fas fa-check-circle"></i> Inventory</span>
        <span class="doc-pill"><i class="fas fa-check-circle"></i> Economy</span>
        <span class="doc-pill"><i class="fas fa-check-circle"></i> Events</span>
        <span class="doc-pill"><i class="fas fa-check-circle"></i> Logging</span>
      </div>
    </article>
  </div>
</div>

<script src="/javascripts/main.js"></script>
</body>
</html>