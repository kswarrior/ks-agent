<%- include('../partials/header') %>

<%
  const docsPages = [
    { href: '/docs',         label: 'Overview',     icon: 'fas fa-book-open',    active: 'docs' },
    { href: '/docs/api',     label: 'API Reference', icon: 'fas fa-plug',        active: 'docs-api' },
    { href: '/docs/plugins', label: 'Plugins',       icon: 'fas fa-puzzle-piece', active: 'docs-plugins' },
    { href: '/docs/server',  label: 'Server Setup',  icon: 'fas fa-server',       active: 'docs-server' },
  ];
  function isActive(label) { return active === (docsPages.find(p => p.label === label)?.active || '') ? ' active' : ''; }
%>

<div class="main-content">
  <nav class="breadcrumbs">
    <a href="/docs">Documentation</a>
    <span class="sep"><i class="fas fa-chevron-right"></i></span>
    <span class="current">Server Setup</span>
  </nav>

  <div class="doc-layout">
    <aside class="doc-sidebar-nav">
      <h4>Pages</h4>
      <nav class="doc-nav-list">
        <% docsPages.forEach(p => { %>
          <a href="<%= p.href %>" class="<%= isActive(p.label) %>">
            <i class="<%= p.icon %>"></i>
            <%= p.label %>
          </a>
        <% }) %>
      </nav>
    </aside>

    <article class="doc-content">
      <h1><i class="fas fa-server" style="color: var(--success);"></i> Server Setup</h1>
      <p class="doc-desc">Deploy KS Warrior on a Linux VPS or local machine. This guide covers requirements, installation, and runtime configuration.</p>

      <div class="info-callout">
        <strong>Recommended:</strong> Ubuntu 22.04 LTS, 2 vCPU, 4 GB RAM, 25 GB SSD for up to 200 concurrent players.
      </div>

      <h2><i class="fas fa-list-ol"></i> Installation</h2>
      <ol>
        <li>Install Node.js 18+ and npm.</li>
        <li>Clone the repo and run <code>npm install --production</code>.</li>
        <li>Copy <code>.env.example</code> to <code>.env</code> and fill values.</li>
        <li>Start the service: <code>npm start</code>.</li>
        <li>Enable auto-start with your system init (e.g. <code>systemd</code>).</li>
      </ol>

      <h2><i class="fas fa-cog"></i> Configuration</h2>
      <p>Core settings live in <code>config.json</code>:</p>
      <div class="content-block" style="background:var(--bg-primary); border:1px solid var(--border-color);">
<pre style="color:var(--text-secondary); font-size:0.9rem; line-height:1.7;">{
  "port": 3000,
  "host": "0.0.0.0",
  "mcHost": "localhost:25565",
  "rcon": {
    "host": "localhost",
    "port": 25575,
    "password": "CHANGE_ME"
  },
  "db": {
    "client": "sqlite",
    "path": "./data/ksw.db"
  }
}</pre>
      </div>

      <h2><i class="fas fa-network-wired"></i> Ports & Firewall</h2>
      <ul>
        <li><code>3000</code> — web dashboard (adjust in config)</li>
        <li><code>25565</code> — Minecraft (forward as needed)</li>
        <li><code>25575</code> — RCON (keep private)</li>
      </ul>
      <p>Open dashboard port example (<code>ufw</code>):</p>
      <div class="content-block" style="background:var(--bg-primary); border:1px solid var(--border-color);">
        <code>ufw allow 3000/tcp</code>
      </div>

      <h2><i class="fas fa-sync"></i> Process Manager</h2>
      <p>Example <code>systemd</code> unit at <code>/etc/systemd/system/ksw.service</code>:</p>
      <div class="content-block" style="background:var(--bg-primary); border:1px solid var(--border-color);">
<pre style="color:var(--text-secondary); font-size:0.9rem; line-height:1.7;">[Unit]
Description=KS Warrior Service
After=network.target

[Service]
Type=simple
User=ksw
WorkingDirectory=/opt/ksw
ExecStart=/usr/bin/node app.js
Restart=on-failure
RestartSec=10
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target</pre>
      </div>
      <p>Then:</p>
      <div class="content-block" style="background:var(--bg-primary); border:1px solid var(--border-color);">
        <code>systemctl enable --now ksw</code>
      </div>

      <h2><i class="fas fa-check-circle"></i> Verify</h2>
      <p>After starting, confirm health:</p>
      <div class="content-block" style="background:var(--bg-primary); border:1px solid var(--border-color);">
        <code>curl http://localhost:3000/health</code>
      </div>
      <p>Expected response:</p>
      <div class="content-block" style="background:var(--bg-primary); border:1px solid var(--border-color);">
<pre style="color:var(--text-secondary); font-size:0.9rem; line-height:1.7;">{ "status": "ok", "uptime": 42, "version": "1.0.0" }</pre>
      </div>
    </article>
  </div>
</div>

<script src="/javascripts/main.js"></script>
</body>
</html>