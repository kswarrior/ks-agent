<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | KS Warrior</title>
  <link rel="stylesheet" href="/stylesheets/main.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <!-- Top Header -->
  <header class="top-header">
    <div class="header-left">
      <button class="sidebar-toggle" id="sidebarToggle">
        <i class="fas fa-bars"></i>
      </button>
      <div class="logo">
        <i class="fas fa-dungeon"></i>
        <span>KS <strong>Warrior</strong></span>
      </div>
    </div>
    <div class="header-right">
      <div class="search-bar">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search..." />
      </div>
      <div class="header-actions">
        <div class="user-profile">
          <div class="avatar">
            <img src="https://mc-heads.net/avatar/KS_Warrior/64" alt="Avatar" onerror="this.src='/images/avatar-placeholder.png'">
          </div>
          <div class="user-info">
            <span class="username"><%= user.username %></span>
            <span class="rank-badge diamond"><%= user.rank %></span>
          </div>
        </div>
        <button class="btn-icon" title="Notifications">
          <i class="fas fa-bell"></i>
          <span class="badge">3</span>
        </button>
        <button class="btn-icon" title="Settings">
          <i class="fas fa-cog"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar">
    <nav class="sidebar-nav">
      <ul>
        <li class="<%= active === 'dashboard' ? 'active' : '' %>">
          <a href="/"><i class="fas fa-th-large"></i><span>Dashboard</span></a>
        </li>
        <li class="<%= active === 'stats' ? 'active' : '' %>">
          <a href="/stats"><i class="fas fa-chart-bar"></i><span>Stats</span></a>
        </li>
        <li class="<%= active === 'about' ? 'active' : '' %>">
          <a href="/about"><i class="fas fa-user"></i><span>About</span></a>
        </li>
        <li class="<%= active === 'players' ? 'active' : '' %>">
          <a href="#"><i class="fas fa-users"></i><span>Players</span></a>
        </li>
        <li class="<%= active === 'servers' ? 'active' : '' %>">
          <a href="#"><i class="fas fa-server"></i><span>Servers</span></a>
        </li>
        <li class="<%= active === 'inventory' ? 'active' : '' %>">
          <a href="#"><i class="fas fa-gem"></i><span>Inventory</span></a>
        </li>
        <li class="<%= active === 'clan' ? 'active' : '' %>">
          <a href="#"><i class="fas fa-shield-alt"></i><span>My Clan</span></a>
        </li>
        <li class="<%= active === 'leaderboard' ? 'active' : '' %>">
          <a href="#"><i class="fas fa-trophy"></i><span>Leaderboard</span></a>
        </li>

        <li><hr class="sidebar-nav-divider" /></li>

        <li class="sidebar-nav-label">Documentation</li>
        <li class="<%= active === 'docs' ? 'active' : '' %>">
          <a href="/docs"><i class="fas fa-book-open"></i><span>Overview</span>
            <span class="doc-badge new">New</span></a>
        </li>
        <li class="<%= active === 'docs-api' ? 'active' : '' %>">
          <a href="/docs/api"><i class="fas fa-plug"></i><span>API Reference</span></a>
        </li>
        <li class="<%= active === 'docs-plugins' ? 'active' : '' %>">
          <a href="/docs/plugins"><i class="fas fa-puzzle-piece"></i><span>Plugins</span></a>
        </li>
        <li class="<%= active === 'docs-server' ? 'active' : '' %>">
          <a href="/docs/server"><i class="fas fa-server"></i><span>Server Setup</span></a>
        </li>
      </ul>
    </nav>
    <div class="sidebar-footer">
      <div class="user-card">
        <img src="https://mc-heads.net/avatar/KS_Warrior/64" alt="Avatar" onerror="this.src='/images/avatar-placeholder.png'" class="sidebar-avatar">
        <div class="user-details">
          <div class="name"><%= user.username %></div>
          <div class="level">Level <%= user.level %></div>
        </div>
        <i class="fas fa-chevron-right"></i>
      </div>
    </div>
  </aside>