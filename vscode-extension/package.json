{
  "name": "ks-agent-vscode",
  "displayName": "KS Agent — Inline Autocomplete & Chat",
  "description": "IDE-native inline autocomplete (ghost text) + inline chat (⌘K) powered by KS Agent — any OpenAI-compatible model, self-hosted.",
  "publisher": "ks-warrior",
  "version": "0.1.0",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "keywords": ["ai", "autocomplete", "inline-chat", "ks-agent", "copilot", "next-edit", "ghost-text"],
  "icon": "icon.png",
  "galleryBanner": { "color": "#0a0a0a", "theme": "dark" },
  "repository": { "type": "git", "url": "https://github.com/kswarrior/ks-agent" },
  "homepage": "https://github.com/kswarrior/ks-agent#readme",
  "bugs": { "url": "https://github.com/kswarrior/ks-agent/issues" },
  "license": "MIT",
  "qna": "marketplace",
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "ks-agent.inlineChat", "title": "KS Agent: Inline Chat (Edit Selection)" },
      { "command": "ks-agent.connect", "title": "KS Agent: Connect to Server" },
      { "command": "ks-agent.showStatus", "title": "KS Agent: Show IDE Status" }
    ],
    "configuration": {
      "title": "KS Agent",
      "properties": {
        "ksAgent.baseUrl": {
          "type": "string",
          "default": "http://localhost:8787",
          "description": "KS Agent server base URL (where `npm start` runs). Used for inline completion & chat."
        },
        "ksAgent.modelId": {
          "type": "string",
          "default": "",
          "description": "Optional modelId to use for IDE features. Empty = server default model."
        },
        "ksAgent.enableInlineCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Enable ghost-text inline completion while typing."
        },
        "ksAgent.debounceMs": {
          "type": "number",
          "default": 350,
          "description": "Debounce (ms) before requesting a completion. Clamped 80–2000, default 350. Lower = more responsive, higher = fewer provider calls.",
          "minimum": 80,
          "maximum": 2000
        }
      }
    },
    "keybindings": [
      { "command": "ks-agent.inlineChat", "key": "cmd+k", "mac": "cmd+k", "when": "editorTextFocus" },
      { "command": "ks-agent.inlineChat", "key": "ctrl+k", "when": "editorTextFocus" }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
