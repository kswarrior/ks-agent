{
  "name": "minecraft-panel",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "tsc -p server/tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "start": "node dist-server/index.js",
    "preview": "vite preview --port 3456"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "ws": "^8.18.0",
    "uuid": "^10.0.0",
    "archiver": "^7.0.0",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@types/uuid": "^10.0.0",
    "@types/archiver": "^6.0.2",
    "@types/mime-types": "^2.1.4",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}