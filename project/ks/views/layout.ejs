<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Minecraft Server Panel</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⛏️</text></svg>">
</head>
<body>
  <div class="app-container">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <h1>⛏️ MC Panel</h1>
      </div>
      <nav class="sidebar-nav">
        <a href="/dashboard" class="<%= activePage === 'dashboard' ? 'active' : '' %>">
          <span class="icon">📊</span> Dashboard
        </a>
        <a href="/console" class="<%= activePage === 'console' ? 'active' : '' %>">
          <span class="icon">🖥️</span> Console
        </a>
        <a href="/files" class="<%= activePage === 'files' ? 'active' : '' %>">
          <span class="icon">📁</span> File Manager
        </a>
        <a href="/settings" class="<%= activePage === 'settings' ? 'active' : '' %>">
          <span class="icon">⚙️</span> Settings
        </a>
        <a href="/backups" class="<%= activePage === 'backups' ? 'active' : '' %>">
          <span class="icon">💾</span> Backups
        </a>
        <a href="/players" class="<%= activePage === 'players' ? 'active' : '' %>">
          <span class="icon">👥</span> Players
        </a>
        <a href="/plugins" class="<%= activePage === 'plugins' ? 'active' : '' %>">
          <span class="icon">🔌</span> Plugins/Mods
        </a>
      </nav>
      <div class="sidebar-footer">
        <div class="server-status-small">
          <span class="status-dot <%= status.status %>"></span>
          <span><%= status.status.charAt(0).toUpperCase() + status.status.slice(1) %></span>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <!-- Top Bar -->
      <header class="top-bar">
        <h2><%= title %></h2>
        <div class="top-bar-actions">
          <div class="server-controls">
            <% if (status.status === 'running') { %>
              <button class="btn btn-danger" onclick="serverAction('stop')">Stop</button>
              <button class="btn btn-warning" onclick="serverAction('restart')">Restart</button>
            <% } else if (status.status === 'starting') { %>
              <button class="btn btn-secondary" disabled>Starting...</button>
            <% } else { %>
              <button class="btn btn-success" onclick="serverAction('start')">Start</button>
            <% } %>
          </div>
        </div>
      </header>

      <!-- Page Content -->
      <div class="page-content">
        <%- body %>
      </div>
    </main>
  </div>

  <script src="/js/main.js"></script>
  <%- scripts || '' %>
</body>
</html>