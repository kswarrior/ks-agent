<div class="card full-height">
  <div class="card-header">
    <h3>Server Settings (server.properties)</h3>
    <button class="btn btn-primary" onclick="saveSettings()">Save Settings</button>
  </div>
  <div class="card-body">
    <form id="settings-form">
      <div class="settings-grid">
        <% const categories = {
          'Server': ['server-name', 'motd', 'server-port', 'max-players', 'online-mode', 'gamemode', 'difficulty', 'hardcore', 'pvp', 'spawn-protection', 'spawn-npcs', 'spawn-animals', 'spawn-monsters', 'generate-structures'],
          'World': ['level-name', 'level-seed', 'level-type', 'generator-settings', 'force-gamemode', 'allow-flight', 'allow-nether', 'view-distance', 'simulation-distance'],
          'Network': ['server-ip', 'network-compression-threshold', 'use-native-transport', 'enable-query', 'query-port', 'enable-rcon', 'rcon-port', 'rcon-password', 'broadcast-rcon-to-ops', 'broadcast-console-to-ops'],
          'Performance': ['max-tick-time', 'max-world-size', 'entity-broadcast-range-percentage', 'mob-spawn-range', 'player-idle-timeout', 'function-permission-level', 'op-permission-level'],
          'Misc': ['enable-command-block', 'enable-jmx-monitoring', 'enable-status', 'enforce-whitelist', 'white-list', 'hide-online-players', 'prevent-proxy-connections', 'require-resource-pack', 'resource-pack', 'resource-pack-sha1', 'resource-pack-prompt', 'sync-chunk-writes', 'text-filtering-config', 'text-filtering-version']
        }; %>

        <% Object.entries(categories).forEach(([category, keys]) => { %>
          <fieldset class="settings-category">
            <legend><%= category %></legend>
            <% keys.forEach(key => { %>
              <% if (properties[key] !== undefined) { %>
                <div class="form-group">
                  <label for="<%= key %>"><%= key %></label>
                  <input type="text" id="<%= key %>" name="<%= key %>" value="<%= escapeHtml(properties[key]) %>">
                </div>
              <% } %>
            <% }); %>
          </fieldset>
        <% }); %>
      </div>
    </form>
  </div>
</div>

<script>
  function saveSettings() {
    const formData = new FormData(document.getElementById('settings-form'));
    const settings = Object.fromEntries(formData);
    
    fetch('/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(settings)
    }).then(r => r.json()).then(res => {
      if (res.success) {
        alert('Settings saved! Restart the server for changes to take effect.');
      } else {
        alert('Save failed');
      }
    });
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }
</script>