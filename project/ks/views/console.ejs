<div class="card full-height">
  <div class="card-header">
    <h3>Server Console</h3>
    <div class="console-controls">
      <span class="connection-status" id="ws-status">
        <span class="status-dot"></span> Connecting...
      </span>
      <button class="btn btn-secondary" onclick="clearConsole()">Clear</button>
    </div>
  </div>
  <div class="card-body console-container">
    <div class="console-output" id="console-output">
      <% if (buffer && buffer.length > 0) { %>
        <% buffer.forEach(entry => { %>
          <div class="console-line <%= entry.error ? 'error' : '' %>" data-time="<%= entry.time %>">
            <span class="console-time"><%= new Date(entry.time).toLocaleTimeString() %></span>
            <span class="console-text"><%= escapeHtml(entry.line) %></span>
          </div>
        <% }); %>
      <% } %>
    </div>
    <div class="console-input-area">
      <form id="command-form" onsubmit="return sendCommand(event)">
        <input type="text" id="command-input" placeholder="Enter command (e.g., say Hello, gamemode creative @a)..." autocomplete="off">
        <button type="submit" class="btn btn-primary" <%= status.status !== 'running' ? 'disabled' : '' %>>Send</button>
      </form>
    </div>
  </div>
</div>

<script>
  const ws = new WebSocket(`ws://${window.location.host}`);
  const output = document.getElementById('console-output');
  const statusEl = document.getElementById('ws-status');
  const commandInput = document.getElementById('command-input');
  const commandForm = document.getElementById('command-form');
  let autoScroll = true;

  ws.onopen = () => {
    statusEl.innerHTML = '<span class="status-dot connected"></span> Connected';
    statusEl.className = 'connection-status connected';
  };

  ws.onclose = () => {
    statusEl.innerHTML = '<span class="status-dot disconnected"></span> Disconnected - Reconnecting...';
    statusEl.className = 'connection-status disconnected';
    setTimeout(() => location.reload(), 3000);
  };

  ws.onmessage = (event) => {
    const msg = JSON.parse(event.data);
    if (msg.type === 'console') {
      appendLine(msg.line, msg.error, msg.time);
    } else if (msg.type === 'status') {
      updateServerStatus(msg.status);
    } else if (msg.type === 'init') {
      msg.buffer.forEach(entry => appendLine(entry.line, entry.error, entry.time));
      updateServerStatus(msg.status);
    }
  };

  function appendLine(line, isError, time) {
    const div = document.createElement('div');
    div.className = 'console-line' + (isError ? ' error' : '');
    div.dataset.time = time;
    div.innerHTML = `<span class="console-time">${new Date(time).toLocaleTimeString()}</span><span class="console-text">${escapeHtml(line)}</span>`;
    output.appendChild(div);
    if (autoScroll) output.scrollTop = output.scrollHeight;
  }

  function updateServerStatus(status) {
    const sendBtn = commandForm.querySelector('button[type="submit"]');
    sendBtn.disabled = status !== 'running';
    // Update top bar status
    const statusDots = document.querySelectorAll('.status-dot');
    statusDots.forEach(dot => {
      dot.className = 'status-dot ' + status;
    });
  }

  function sendCommand(event) {
    event.preventDefault();
    const command = commandInput.value.trim();
    if (!command) return;

    fetch('/api/server/command', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ command })
    }).then(r => r.json()).then(res => {
      if (!res.success) {
        appendLine(`[ERROR] ${res.message}`, true, new Date().toISOString());
      }
    });

    commandInput.value = '';
    return false;
  }

  function clearConsole() {
    output.innerHTML = '';
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // Auto-scroll toggle
  output.addEventListener('scroll', () => {
    autoScroll = output.scrollTop + output.clientHeight >= output.scrollHeight - 10;
  });

  commandInput.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowUp') {
      // Could add command history here
    }
  });
</script>