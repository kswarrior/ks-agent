<div class="card full-height">
  <div class="card-header">
    <h3><%= editMode ? 'Edit' : 'View' %>: <%= file %></h3>
    <div class="file-view-actions">
      <% if (!editMode) { %>
        <a href="/files/view?file=<%= encodeURIComponent(file) %>&edit=1" class="btn btn-secondary">Edit</a>
      <% } else { %>
        <button class="btn btn-primary" onclick="saveFile()">Save</button>
      <% } %>
      <a href="/files?dir=<%= encodeURIComponent(file.split('/').slice(0, -1).join('/')) %>" class="btn btn-secondary">Back</a>
    </div>
  </div>
  <div class="card-body">
    <% if (editMode) { %>
      <form id="editor-form" onsubmit="return saveFile(event)">
        <textarea id="editor" name="content" spellcheck="false"><%= escapeHtml(content) %></textarea>
        <div class="editor-actions">
          <button type="submit" class="btn btn-primary">Save Changes</button>
          <a href="/files/view?file=<%= encodeURIComponent(file) %>" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    <% } else { %>
      <pre class="file-content"><%= escapeHtml(content) %></pre>
    <% } %>
  </div>
</div>

<script>
  const editMode = <%= editMode ? 'true' : 'false' %>;

  if (editMode) {
    const textarea = document.getElementById('editor');
    // Auto-resize textarea
    textarea.style.height = (textarea.scrollHeight) + 'px';
    textarea.addEventListener('input', () => {
      textarea.style.height = 'auto';
      textarea.style.height = (textarea.scrollHeight) + 'px';
    });
  }

  function saveFile(event) {
    if (event) event.preventDefault();
    const content = document.getElementById('editor').value;
    fetch('/files/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ file: '<%= escapeJs(file) %>', content })
    }).then(r => r.json()).then(res => {
      if (res.success) {
        alert('File saved successfully');
        window.location.href = '/files/view?file=<%= encodeURIComponent(file) %>';
      } else {
        alert('Save failed: ' + res.message);
      }
    });
    return false;
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function escapeJs(text) {
    return text.replace(/'/g, "\\'").replace(/"/g, '\\"');
  }
</script>