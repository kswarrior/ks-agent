{
  "name": "panel",
  "version": "0.1.0",
  "description": "Minecraft Java Edition Server management panel - single server focus",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p server/tsconfig.json",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p web/tsconfig.json",
    "retest": "echo \"Starting server on port 8080...\""
  },
  "dependencies": {
    "hono": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^2.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.2.0"
  }
}