{
  "name": "ks-minecraft-panel",
  "version": "1.0.0",
  "description": "KS Minecraft Server Management Panel",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx server/src/index.ts",
    "dev:web": "vite",
    "build": "tsc -p server/tsconfig.json && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node dist-server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2",
    "vite": "^5.0.10"
  }
}
