{
  "name": "minecraft-panel",
  "version": "1.0.0",
  "description": "Lightweight Minecraft server management panel",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run web\"",
    "server": "ts-node-dev server/src/index.ts",
    "web": "vite",
    "build": "tsc -p server/tsconfig.json && vite build",
    "typecheck": "tsc -p server/tsconfig.json",
    "start": "node dist-server/index.js & vite preview"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "zod": "^3.22.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/hono": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}