# Server
PORT=3001
NODE_ENV=development

# Auth — CHANGE THESE for production
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Minecraft server directory (absolute path)
MC_SERVER_DIR=/path/to/your/minecraft/server

# Java path (or just "java" if on PATH)
JAVA_BIN=java

# Start command — %s is replaced with MC_SERVER_DIR
# Example vanilla:
#   MC_START_CMD=cd "%s" && java -Xmx1024M -Xms1024M -jar server.jar nogui
# Example Paper (uses flags file):
#   MC_START_CMD=cd "%s" && java -Xms1G -Xmx2G -jar paper.jar --nogui
# Example script wrapper:
#   MC_START_CMD=/opt/mc/start.sh
MC_START_CMD=cd "%s" && java -Xmx1024M -Xms1024M -jar server.jar nogui

# Stop command sent via RCON/stop. Wrapper script can override MC_STOP_CMD too.
# Leave blank to use RCON "stop" command.
MC_STOP_CMD=

# RCON (must match server.properties rcon.port / rcon.password)
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=change-me

# Log file (relative to MC_SERVER_DIR, or absolute)
MC_LOG_FILE=logs/latest.log
