<h2>Dashboard</h2>
<section class="stats-grid">
  <% stats.forEach(stat => { %>
    <div class="stat-card" style="border-left-color: <%= stat.color %>;">
      <div class="stat-value"><%= stat.value %></div>
      <div class="stat-label"><%= stat.label %></div>
    </div>
  <% }) %>
</section>
<section class="card">
  <h3>Recent Activity</h3>
  <table class="table">
    <thead>
      <tr>
        <th>User</th>
        <th>Action</th>
        <th>Time</th>
      </tr>
    </thead>
    <tbody>
      <% recentActivity.forEach(item => { %>
        <tr>
          <td><%= item.user %></td>
          <td><%= item.action %></td>
          <td><%= item.time %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<section class="card">
  <h3>Documentation Overview</h3>
  <div class="docs-section-grid">
    <% docsSection.forEach(doc => { %>
      <div class="docs-mini-card">
        <h4><%= doc.title %></h4>
        <p><%= doc.pages %> pages</p>
        <small>Updated <%= doc.updated %></small>
      </div>
    <% }) %>
  </div>
</section>